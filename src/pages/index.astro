---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import figmaLogo from "@/assets/logos/figma.svg";
import PageLayout from "@/layouts/Base";
import PostPreview from "@/components/blog/PostPreview";
import PreviousRoles from "@/components/PreviousRoles";
import SocialList from "@/components/SocialList";
import { sortMDByDate } from "@/utils";

const MAX_POSTS = 10;
const allPosts = await getCollection("post");
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const uses: Array<{ title: string; desc: string; href: string }> = [
  {
    title: "Ghostty + Fish + Neovim",
    desc: "Vim made writing code fun again.",
    href: "https://lazyvim.org",
  },
  {
    title: "Rider",
    desc: "Visual Studio but better.",
    href: "https://www.jetbrains.com/rider",
  },
  {
    title: "Obsidian",
    desc: "Notetaking.",
    href: "https://obsidian.md/",
  },
  {
    title: "JetBrains Mono NerdFont",
    desc: "Current coding typeface.",
    href: "https://www.jetbrains.com/lp/mono/",
  },
  {
    title: "14 Inch MacBook Pro (M4 Pro, 2025)",
    desc: "The workhorse.",
    href: "https://www.apple.com/macbook-pro/",
  },
  {
    title: "Think 6.5 v2 Keyboard",
    desc: "The keyboard I spent way too much money on.",
    href: "https://graystudio.club/products/gb-think6-5-v2",
  },
  {
    title: "Raycast",
    desc: "Super slick extendable launcher for macOS.",
    href: "https://www.raycast.com/",
  },
  {
    title: "Arc Browser",
    desc: "This browser changed the way I work.",
    href: "https://arc.net/",
  },
];

const meta = {
  title: "Home",
  description:
    "Nate is an Open Source Developer at Figma working on Payload, based in Grand Rapids, MI.",
};
---

<PageLayout meta={{ title: meta.title, description: meta.description }}>
  <section>
    <h1 class="title mb-6"></h1>
    <p class="mb-4">
      Hi, I’m an Open Source Developer at <span
        class="group relative inline-block"
      >
        <a href="https://www.figma.com" class="underline">Figma</a>
        <span
          class="pointer-events-none absolute bottom-full left-1/2 mb-2 origin-bottom -translate-x-1/2 translate-y-1 scale-90 opacity-0 transition duration-200 ease-out group-focus-within:translate-y-0 group-focus-within:scale-100 group-focus-within:opacity-100 motion-reduce:transition-none sm:group-hover:translate-y-0 sm:group-hover:scale-100 sm:group-hover:opacity-100"
          aria-hidden="true"
        >
          <Image src={figmaLogo} alt="" loading="eager" class="h-6 w-auto" />
        </span>
      </span>, working on <a href="https://payloadcms.com" class="underline">Payload</a
      >, based in Grand Rapids, MI.
    </p>
    <PreviousRoles />
    <div class="mt-6">
      <SocialList />
    </div>
  </section>
  <!-- <section aria-label="Blog post list" class="mt-16"> -->
  <!-- 	<h2 class="title mb-4 text-xl">Posts</h2> -->
  <!-- 	<ul class="space-y-4 sm:space-y-2"> -->
  <!-- 		{ -->
  <!-- 			allPostsByDate.map((p) => ( -->
  <!-- 				<li class="flex flex-col gap-x-2 sm:flex-row"> -->
  <!-- 					<PostPreview post={p} /> -->
  <!-- 				</li> -->
  <!-- 			)) -->
  <!-- 		} -->
  <!-- 	</ul> -->
  <!-- </section> -->
  <section class="mt-16">
    <h2 class="title mb-4 text-xl">Uses</h2>
    <p class="mb-4 text-sm">Notable software and hardware that I use daily.</p>
    <ul class="space-y-4 sm:space-y-2">
      {
        uses.map(({ href, title, desc }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="cactus-link inline-block"
            >
              {title}:
            </a>
            <p class="inline-block sm:mt-2"> {desc}</p>
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>
